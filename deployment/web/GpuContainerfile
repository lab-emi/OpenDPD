FROM docker.io/pytorch/pytorch:2.14.0-cuda13.2-cudnn9-runtime@sha256:773f5f0122b8d6413ff1e47559d98a3a22896434822e2d7752ba8d5b85a363d7
WORKDIR /opt/opendpd
# Triton compiles its CUDA driver/launchers on first use. Retain the C compiler,
# libc headers and matching Python headers in the runtime, including cold jobs.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends gcc python3-dev && apt-get purge -y python3-pip python3-wheel && rm -rf /var/lib/apt/lists/*
RUN uv venv --system-site-packages --python /usr/bin/python /opt/opendpd-runtime
ENV PATH="/opt/opendpd-runtime/bin:${PATH}"
COPY deployment/web/requirements-gpu.lock /tmp/requirements-gpu.lock
RUN uv pip install --python /opt/opendpd-runtime --no-cache --require-hashes -r /tmp/requirements-gpu.lock
COPY pyproject.toml README.md LICENSE arguments.py project.py models.py main.py ./
COPY opendpd ./opendpd
COPY backbones ./backbones
COPY modules ./modules
COPY steps ./steps
COPY utils ./utils
COPY quant ./quant
COPY datasets ./datasets
COPY dataset ./dataset
RUN uv pip install --python /opt/opendpd-runtime --no-cache --no-deps --no-build-isolation . && chmod -R a-w /opt/opendpd
# No package installation is needed in an offline inference/training worker.
# Remove installers and their bundled dependencies after building the app.
RUN uv pip uninstall --system --break-system-packages pip setuptools wheel uv
USER 65532:65532
ENTRYPOINT ["python", "-m", "opendpd.web.gpu_container"]
