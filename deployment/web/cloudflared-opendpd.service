[Unit]
Description=OpenDPD outbound-only Cloudflare Tunnel connector (host)
After=network-online.target opendpd-web-vm.service
Wants=network-online.target
Requires=opendpd-web-vm.service

[Service]
User=opendpd-tunnel
Group=opendpd-tunnel
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/opendpd-web/cloudflared.yml tunnel run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=128
LimitCORE=0

[Install]
WantedBy=multi-user.target
