[Unit]
Description=Hard twice-daily deletion of public Studio temporary data

[Timer]
# Drain begins at 11:55 / 23:55 UTC. Discard the private tmpfs before
# either 12-hour boundary, including if an individual request is stuck.
OnCalendar=*-*-* 11,23:59:00 UTC
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=opendpd-web-reset.service

[Install]
WantedBy=timers.target
