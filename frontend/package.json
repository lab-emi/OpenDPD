{
  "name": "opendpd-studio",
  "private": true,
  "version": "2.2.0-dev0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src e2e web-e2e touch-e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "types:generate": "openapi-typescript ../docs/contracts/openapi.json -o src/api/schema.ts",
    "types:check": "openapi-typescript ../docs/contracts/openapi.json -o /tmp/opendpd-schema-check.ts && diff -q /tmp/opendpd-schema-check.ts src/api/schema.ts",
    "e2e:web": "VITE_STUDIO_MODE=web VITE_API_ORIGIN=https://api.opendpd.com vite build --outDir /tmp/opendpd-web-e2e && playwright test --config playwright.web.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.102.8",
    "plotly.js-basic-dist-min": "4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
