{
  "name": "opendpd-studio",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/@typescript/native/bin/tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "lint": "oxlint src e2e web-e2e touch-e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "types:generate": "openapi-typescript ../docs/contracts/openapi.json -o src/api/schema.ts",
    "types:check": "mkdir -p .cache && openapi-typescript ../docs/contracts/openapi.json -o .cache/schema-check.ts && diff -q .cache/schema-check.ts src/api/schema.ts",
    "e2e:web": "VITE_STUDIO_MODE=web VITE_API_ORIGIN=https://api.opendpd.com vite build --outDir .cache/web-e2e && playwright test --config playwright.web.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.104.2",
    "katex": "^0.19.0",
    "plotly.js-basic-dist-min": "4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.79.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
