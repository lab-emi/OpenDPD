# MANIFEST.in - Include additional files in the distribution

# Include documentation
include README.md
include LICENSE

# Include dataset specifications and CSV files
recursive-include datasets *.json *.csv
recursive-include dataset *.json *.csv *.md
recursive-include backbones *

# Keep cached sdist manifests from retaining historical Arena experiments.
recursive-exclude opendpd/arena_assets syn-* *-judge-*.npz *-teacher.npz *-stimuli-*.npz *-pa-v[2345].npz calibration-v[12345].json reference-results-v[12345].json

# Include the built Studio frontend when present (release builds)
recursive-include opendpd/studio/static *
include opendpd/studio/icon.png
include opendpd/studio/icon.ico

# Include automation scripts
recursive-include bash_scripts *.sh

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
exclude .gitignore
exclude .git
recursive-exclude Matlab *
# Ship the source-only toolbox preview in sdists; historical bench scripts stay separate.
recursive-include Matlab/toolbox *.m *.md *.html *.css *.js *.svg LICENSE
recursive-exclude slprj *
recursive-exclude pics *
recursive-exclude save *
recursive-exclude log *
recursive-exclude dpd_out *
exclude *.sh

prune papers
prune docs
prune deployment
prune .github
prune .vscode
prune frontend
prune tests
prune output
prune benchmark
prune pics
exclude CODE_REVIEW_REPORT.md
exclude *Plan*.md

# APA_200MHz_b is the sole published Arena dataset.
recursive-exclude opendpd/arena_assets dpa-* apa-200mhz-data.npz apa-200mhz-measured-v4.npz apa-200mhz-pa-v6.npz reference-results-v6.json
